      "css": ".ds-nav{display:flex;gap:12px;max-width:300px}.ds-tool{min-height:44px;padding:8px 16px;border:1px solid var(--ui-border-strong,#b8c9bc);color:var(--ui-text,#20332b);background:linear-gradient(-75deg,#ffffff0d,#ffffff30,#ffffff0d);position:relative;border-radius:999px;box-shadow:inset 0 2px 3px #ffffff35,inset 0 -2px 2px #ffffff55,0 8px 16px #00000025;backdrop-filter:blur(4px);transition:transform .25s ease}.ds-tool:hover:not(:disabled){transform:scale(.975)}.ds-tool:active:not(:disabled){transform:perspective(600px) rotateX(12deg) scale(.97)}.ds-control:focus-visible{outline:3px solid #78ad97;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-tool{transition:none;transform:none!important}}@media(prefers-reduced-transparency:reduce){.ds-tool{background:var(--ui-surface,#fff);backdrop-filter:none}}"
